# Settings for the benchmark check and the benchmarks.
# See bench/README.md for why each value was chosen. Keep values free of spaces
# and '#', and leave a space before an inline comment.

# How strict the check is: defaults. Setting the same variable in the
# environment overrides each (locally also `make bench-compare THRESHOLD=...
# RUNS=...`; in CI, a repository variable).
BENCH_FAIL_THRESHOLD=20%          # fail if a median is more than this much slower
BENCH_RUNS=5                      # runs per side; the check compares their medians
BENCH_NOISE_WARN=15%              # warn if a benchmark's runs differ by more than this

# What the benchmarks measure. Change these in a reviewed PR, and rerun the
# threshold experiment if you do.
ROUNDS=50                         # timed rounds per benchmark
MISS_TOKENS=10                    # distinct tokens verified per round in the cache-miss benchmarks
CACHE_SIZE=10000                  # live entries in the cache get/set benchmarks
BATCH_SIZE=100                    # cache gets/sets per timed call
EXPIRED_ENTRIES=1000              # expired entries cleared by the purge benchmark
